<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Looker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Looker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Looker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Looker"
    mc:Ignorable="d">
    <!-- No system backdrop: the window is a fixed solid black (RootGrid.Background) and the app forces the
         Dark theme + its own accent colour in App.xaml, so nothing follows the user's Windows theme/accent. -->

    <!--
        Root layout (plan "UI Layout"): [TitleBar] / [Toolbar auto] / [Viewport *] / [ThumbnailStrip auto, added M6] / [StatusRow auto].
        Modifier-less keys are KeyboardAccelerators on the root grid (not KeyDown handlers), scoped
        so they stay inert while a rename/flyout TextBox has focus (M7). Focus is parked on the
        viewport so the accelerators fire immediately after launch.
    -->
    <!-- KeyboardAcceleratorPlacementMode=Hidden suppresses the automatic tooltip WinUI otherwise shows for
         an element's accelerators (which surfaced a stray "Left"/"Right" tooltip on hover). -->
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="Black"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="OnRootLoaded">
        <Grid.Resources>
            <!-- White icons/text on accent-filled (checked toggle / AccentButtonStyle) surfaces. The Dark theme
                 defaults these to black. Lightweight-styling overrides only take effect from an element scope
                 (the templates resolve them by walking up from the control), not from App.xaml. -->
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#CCFFFFFF" />

            <!-- Brighter resting fill for every button than the stock ControlFillColorDefault (6% white), which
                 reads as near-invisible on the solid black window. Hover/pressed are lifted in step so the states
                 still separate. Button, ToggleButton (unchecked) and DropDownButton all resolve these keys from
                 the nearest element scope; WhiteOnAccent() repeats them for dialogs (own root). -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#1CFFFFFF" />

            <!-- Toolbar buttons. Must be BasedOn the default Button style: an explicit style with
                 no BasedOn replaces the default one entirely (dropping the ControlTemplate), which makes the
                 buttons render as bare/"fake" content. Inheriting keeps the real WinUI chrome so they match
                 the sort DropDownButton; we only vertically center them in the row. -->
            <Style
                x:Key="ToolbarButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="32" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Invoked="OnAccelPrevious" />
            <KeyboardAccelerator Key="Right" Invoked="OnAccelNext" />
            <KeyboardAccelerator Key="Home" Invoked="OnAccelFirst" />
            <KeyboardAccelerator Key="End" Invoked="OnAccelLast" />
            <!-- PDF pages. Unhandled (routes on) unless a multi-page document is showing. -->
            <KeyboardAccelerator Key="PageUp" Invoked="OnAccelPreviousPage" />
            <KeyboardAccelerator Key="PageDown" Invoked="OnAccelNextPage" />
            <KeyboardAccelerator Key="F" Invoked="OnAccelFit" />
            <KeyboardAccelerator Key="Space" Invoked="OnAccelPlayPause" />
            <KeyboardAccelerator Key="Number1" Invoked="OnAccelActualSize" />
            <KeyboardAccelerator Key="T" Invoked="OnAccelToggleStrip" />
            <KeyboardAccelerator Key="I" Invoked="OnAccelToggleInfo" />
            <KeyboardAccelerator Key="E" Invoked="OnAccelToggleExplorer" />
            <!-- File explorer keyboard cursor. Left unhandled (so the key routes on normally) while the card is
                 hidden, and Enter also when the cursor has nothing to act on — a focused button keeps its Enter. -->
            <KeyboardAccelerator Key="Up" Invoked="OnAccelExplorerUp" />
            <KeyboardAccelerator Key="Down" Invoked="OnAccelExplorerDown" />
            <KeyboardAccelerator Key="Enter" Invoked="OnAccelExplorerEnter" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnAccelActualSize" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="OnAccelFit" />
            <KeyboardAccelerator Modifiers="Control" Key="Add" Invoked="OnAccelZoomIn" />
            <KeyboardAccelerator Modifiers="Control" Key="Subtract" Invoked="OnAccelZoomOut" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnAccelOpenFile" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="O" Invoked="OnAccelOpenFolder" />
            <KeyboardAccelerator Key="Delete" Invoked="OnAccelDelete" />
            <KeyboardAccelerator Key="F2" Invoked="OnAccelRename" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnAccelRotateRight" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="R" Invoked="OnAccelRotateLeft" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnAccelCopyImage" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="C" Invoked="OnAccelCopyPath" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnAccelReveal" />
            <KeyboardAccelerator Key="F11" Invoked="OnAccelFullscreen" />
            <KeyboardAccelerator Key="F5" Invoked="OnAccelSlideshow" />
            <KeyboardAccelerator Key="Escape" Invoked="OnAccelEscape" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Looker">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Row 1: the action toolbar on its own row under the title bar, using default Button chrome to match the
             sort DropDownButton. Image actions are left-aligned; the panel toggles and the More menu are a separate
             right-aligned group. -->
        <Grid Grid.Row="1" Padding="12,0,12,8">
            <StackPanel
                x:Name="ToolbarPanel"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="4">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolPrevious" ToolTipService.ToolTip="Previous (←)">
                    <FontIcon FontSize="16" Glyph="&#xE76B;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolNext" ToolTipService.ToolTip="Next (→)">
                    <FontIcon FontSize="16" Glyph="&#xE76C;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolZoomOut" ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                    <FontIcon FontSize="16" Glyph="&#xE71F;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolFit" ToolTipService.ToolTip="Fit to window (F)">
                    <FontIcon FontSize="16" Glyph="&#xE9A6;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolZoomIn" ToolTipService.ToolTip="Zoom in (Ctrl++)">
                    <FontIcon FontSize="16" Glyph="&#xE8A3;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolFullscreen" ToolTipService.ToolTip="Fullscreen (F11)">
                    <FontIcon FontSize="16" Glyph="&#xE740;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolRotate" ToolTipService.ToolTip="Rotate right (Ctrl+R)">
                    <FontIcon FontSize="16" Glyph="&#xE7AD;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToolDelete" ToolTipService.ToolTip="Delete (Del)">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
                <DropDownButton
                    x:Name="SortButton"
                    Height="32"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Sort">
                    <DropDownButton.Content>
                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="SortName" Text="Name" GroupName="SortField" Click="OnSortName" />
                            <RadioMenuFlyoutItem x:Name="SortDate" Text="Date modified" GroupName="SortField" Click="OnSortDate" />
                            <RadioMenuFlyoutItem x:Name="SortSize" Text="Size" GroupName="SortField" Click="OnSortSize" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="SortAsc" Text="Ascending" GroupName="SortDir" Click="OnSortAscending" />
                            <RadioMenuFlyoutItem x:Name="SortDesc" Text="Descending" GroupName="SortDir" Click="OnSortDescending" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="SaveRotationButton"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="OnToolSaveRotation"
                    Content="Save"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Save the rotation to the file (Ctrl+S)"
                    Visibility="Collapsed" />
            </StackPanel>
            <!-- Right-aligned group: the panel toggles and the More menu, separated from the image actions. -->
            <StackPanel
                x:Name="ToolbarRightPanel"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="HomeButton"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="OnToolHome"
                    ToolTipService.ToolTip="Home">
                    <FontIcon FontSize="16" Glyph="&#xE80F;" />
                </Button>
                <ToggleButton
                    x:Name="ExplorerToggle"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="OnToolExplorer"
                    ToolTipService.ToolTip="File explorer (E)">
                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="StripToggle"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="OnToolStrip"
                    ToolTipService.ToolTip="Thumbnails (T)">
                    <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="InfoToggle"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="OnToolInfo"
                    ToolTipService.ToolTip="Info panel (I)">
                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                </ToggleButton>
                <!-- Settings page toggle (the former More menu; its file actions live in the context menu and on the
                     landing page). Checked = the page is open, so it lights up like the panel toggles. -->
                <ToggleButton
                    x:Name="SettingsToggle"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="OnToolSettings"
                    ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <!-- Accent dot: shown by UpdateService when the Store has a newer version (the Updates block
                             sits at the top of the Settings page). -->
                        <Ellipse
                            x:Name="UpdateDot"
                            Width="7"
                            Height="7"
                            Margin="0,-4,-6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Row 2: viewport + floating cards. The info card overlays the viewport column right-aligned and the file
             explorer card left-aligned, so the checkerboard shows around them; ImageViewport.RightInset/LeftInset
             keep the image fitting in the space between. The Auto column is now unused and stays at 0. -->
        <!-- Row 2 hosts the viewport plus three panels that start hidden and are therefore created lazily in
             code-behind (EmptyState, InfoPanel, ThumbnailStrip go in row 3) rather than parsed on every launch. -->
        <Grid x:Name="ViewportGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:ImageViewport x:Name="Viewport" Grid.Column="0" IsTabStop="True">
                <!-- Right-click file-management surface (M7). Items mirror the keyboard accelerators and carry
                     the same glyphs as the toolbar / More menu so the three surfaces read as one set. -->
                <controls:ImageViewport.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Rotate right" Click="OnMenuRotateRight">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7AD;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+R</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Rotate left" Click="OnMenuRotateLeft">
                            <MenuFlyoutItem.Icon>
                                <!-- The Rotate glyph mirrored: Segoe Fluent ships no counter-clockwise twin. -->
                                <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+Shift+R</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Copy image" Click="OnMenuCopyImage">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+C</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy path" Click="OnMenuCopyPath">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE71B;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+Shift+C</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Rename" Click="OnMenuRename">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>F2</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Delete" Click="OnMenuDelete">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Del</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Set as wallpaper" Click="OnMenuWallpaper">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE91B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Reveal in File Explorer" Click="OnMenuReveal">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC50;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+E</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="File explorer" Click="OnMenuToggleExplorer">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>E</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Thumbnail strip" Click="OnMenuToggleStrip">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>T</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Info panel" Click="OnMenuToggleInfo">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>I</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </controls:ImageViewport.ContextFlyout>
            </controls:ImageViewport>

            <!-- Transient status toast, bottom-right of the viewport. -->
            <controls:OsdOverlay
                x:Name="Osd"
                Grid.Column="0"
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" />
        </Grid>

        <!-- Row 4: always-on status line under the thumbnail strip (row 3) — native size, megapixels, file size,
             capture time on the left, an "Open in Explorer" link and the "3 / 128" position counter on the right.
             Independent of the info panel; hidden only when nothing is open. Text is set from code
             (OnStatusUpdated / OnCurrentChanged). -->
        <Grid
            x:Name="StatusRow"
            Grid.Row="4"
            Padding="12,4,12,6"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <!-- "Open in Explorer": reveals the current file (selected) in File Explorer. An inline Hyperlink like the
                 info card's path row (hand cursor, no underline): the explicit Foreground covers the resting state (the
                 element-scope resource alone leaves it accent red) and the pointer-over/pressed brushes are set in code. -->
            <TextBlock
                x:Name="StatusReveal"
                Grid.Column="1"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                ToolTipService.ToolTip="Show this file in File Explorer">
                <Hyperlink
                    Click="OnStatusReveal"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    UnderlineStyle="None">Open in Explorer</Hyperlink>
            </TextBlock>
            <!-- "3 / 128" position counter, right end of the status row. -->
            <TextBlock
                x:Name="PositionCounter"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="False" />
        </Grid>
    </Grid>
</Window>
