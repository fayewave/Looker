<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Looker.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Looker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Shown over the viewport when nothing is open (M8). The Win2D surface behind it stays blank (Mica
        shows through), so this is the app's first impression. Buttons raise events the host wires to the
        same pickers as Ctrl+O / Ctrl+Shift+O; the hyperlink opens Settings > Default apps on Looker's page. The recent
        list (M9) is fed by the host from SettingsService each time the empty state becomes visible.
    -->
    <!-- Rows: spacer 2 : content : spacer 3 : default-app hint. The 2:3 split biases the content upward when
         there is room; when there isn't, the code-behind caps ContentScroller.MaxHeight to what's left after the
         hint, the spacers collapse to 0 and the block scrolls instead of clipping (a clipped recent list looks
         like a thumbnail strip at the bottom edge). -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="2*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="3*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer
        x:Name="ContentScroller"
        Grid.Row="1"
        HorizontalAlignment="Center"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
    <StackPanel
        Padding="24,16"
        HorizontalAlignment="Center"
        Spacing="16">
        <!-- Wordmark (vector; Source + rasterization size are set in code once the DPI is known). -->
        <Image
            x:Name="Wordmark"
            Height="52"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Stretch="Uniform" />
        <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="OpenPhotoButton"
                MinWidth="140"
                Click="OnOpenPhoto"
                Content="Open a file" />
            <Button
                x:Name="OpenFolderButton"
                MinWidth="140"
                Click="OnOpenFolder"
                Content="Open a folder" />
        </StackPanel>
        <!-- Recent files: hidden until the host supplies a non-empty list. -->
        <StackPanel
            x:Name="RecentPanel"
            Margin="0,16,0,0"
            Width="480"
            HorizontalAlignment="Center"
            Spacing="4"
            Visibility="Collapsed">
            <Grid Margin="8,0,8,4">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Recent" />
                <Button
                    Padding="10,3"
                    HorizontalAlignment="Right"
                    Click="OnClearRecent"
                    Content="Clear"
                    FontSize="12" />
            </Grid>
            <!-- All RecentFiles.Capacity rows are shown; in a short window the whole block (ContentScroller) scrolls. -->
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="controls:RecentEntry">
                        <Button
                            Padding="6,3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRecentClick"
                            Tag="{x:Bind Path}"
                            ToolTipService.ToolTip="{x:Bind Path}">
                            <!-- Right-click / menu key: drop this entry from the history. -->
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnRemoveRecent"
                                        Tag="{x:Bind Path}"
                                        Text="Remove from recent">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE711;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Shell thumbnail (ThumbnailLoader, same path as the strip); the dark tile shows until it lands. -->
                                <Border
                                    Width="48"
                                    Height="36"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <Image Source="{x:Bind Item.Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Folder}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
    <!-- Bottom row, independent of the centred block. The X hides it for good
         (SettingsService.DefaultHintDismissed); the host applies that flag via SetDefaultHintVisible. -->
    <StackPanel
        x:Name="DefaultHintPanel"
        Grid.Row="3"
        Margin="0,8,0,28"
        HorizontalAlignment="Center"
        Orientation="Horizontal"
        Spacing="6">
        <Button Click="OnSetDefault" Content="Set Looker as your default photo viewer" />
        <!-- No fixed height: the horizontal StackPanel stretches it to the text button's height. -->
        <Button
            Width="32"
            MinHeight="0"
            Padding="0"
            VerticalAlignment="Stretch"
            Click="OnDismissDefaultHint"
            ToolTipService.ToolTip="Don't show this again">
            <FontIcon FontSize="12" Glyph="&#xE711;" />
        </Button>
    </StackPanel>
    </Grid>
</UserControl>
