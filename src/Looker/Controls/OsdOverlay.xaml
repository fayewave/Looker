<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Looker.Controls.OsdOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--
        Transient status toast (M8): zoom %, sort change, "Copied", "1 / 234". Host code calls Show(text);
        the pill fades in, holds ~1.2s, fades out. Never hit-testable (input passes straight to the viewport).
        Positioning (top-left with a margin) is set by the host so the same control can be reused anywhere.
    -->
    <!-- Solid neutral theme fill (not in-app acrylic): acrylic samples/blurs the content behind it, which
         over the transparent viewport is the Mica/wallpaper — a green-ish wallpaper tinted the pill green.
         The solid base-background brush keeps it neutral and matching the app chrome. -->
    <Border
        x:Name="Pill"
        Padding="14,8"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Opacity="0">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <TextBlock
            x:Name="Label"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
    </Border>
</UserControl>
