<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Looker.Controls.PageBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Floating page bar for multi-page documents (PDF): previous / "Page 3 of 12" / next, bottom-centre of the
        preview area. Only these buttons turn pages — the arrow keys keep stepping through the folder — so a PDF
        in a photo folder never interrupts browsing. Same pill as the OSD toast (solid neutral fill, not acrylic,
        so nothing behind it tints it).
    -->
    <Border
        x:Name="Pill"
        Padding="6,4"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                x:Name="PreviousButton"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="PagePrevious"
                Click="OnPrevious"
                ToolTipService.ToolTip="Previous page">
                <FontIcon FontSize="14" Glyph="&#xE76B;" />
            </Button>
            <TextBlock
                x:Name="Label"
                Margin="10,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PageLabel"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                IsTextSelectionEnabled="False" />
            <Button
                x:Name="NextButton"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="PageNext"
                Click="OnNext"
                ToolTipService.ToolTip="Next page">
                <FontIcon FontSize="14" Glyph="&#xE76C;" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
