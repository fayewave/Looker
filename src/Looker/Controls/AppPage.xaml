<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Looker.Controls.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        The shell for Looker's full-window pages (Settings, About) — the same overlay slot as the landing page
        rather than a modal dialog. The host (MainWindow) fills Body from code, calls SetBackground with the
        themed window colour so the photo behind never shows through, and handles BackRequested.

        Header and body share one centred, MaxWidth-capped column: HorizontalAlignment=Stretch with a MaxWidth
        centres the block in the window while still shrinking below the cap on a narrow one. The cap is
        ContentMaxWidth (560 by default); a page that lays itself out in two columns raises it when the body is
        wide enough (BodyWidthChanged / BodyWidth) — the code equivalent of a XAML AdaptiveTrigger.
    -->
    <!-- Background goes on this Grid, not the UserControl: a WinUI UserControl's own Background is not
         rendered by its default template (InfoPanel paints an inner Border for the same reason). -->
    <Grid x:Name="Root" Padding="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="Header"
            Grid.Row="0"
            MaxWidth="560"
            Margin="0,0,0,16"
            HorizontalAlignment="Stretch"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="BackButton"
                Height="32"
                Padding="10,0"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Back (Esc)">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{ThemeResource TitleTextBlockStyle}" />
        </StackPanel>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ContentPresenter
                x:Name="Body"
                MaxWidth="560"
                Padding="0,0,0,24"
                HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</UserControl>
