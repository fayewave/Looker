<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Looker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- M9: Program.Main decides single-instance redirection before the XAML runtime spins up. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- CsWinRT generates unsafe marshalling stubs for generic WinRT interfaces (e.g. IStorageItem[] in the
         clipboard code); required for the trimmed Release/package build to work. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Every logo/icon under Assets (all scales + targetsizes generated by scripts/Generate-Logos.ps1).
    A plain `dotnet build` (no MSIX packaging pass) does not lay Content assets into the loose RID
    output that we register for dev, so also copy them to the output directory so ms-appx:/// assets
    resolve from the registered install location. Proper MSIX packaging (resources.pri) happens in
    scripts/Build-Package.ps1.
  -->
  <ItemGroup>
    <Content Include="Assets\**\*.png;Assets\**\*.ico;Assets\**\*.svg;Assets\**\*.ttf;Assets\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <!--
    Version pins (see plan.md "Research verified"): Win2D 1.4.0 targets WinAppSDK 1.8.x and
    2.x binary compat is unconfirmed, so pin WinAppSDK to the latest 1.8 patch. Re-check Win2D
    releases before bumping; only move both together once Win2D explicitly supports 2.x.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
  </ItemGroup>

  <!--
    M4: Magick.NET is the fallback decoder for formats WIC can't handle on a given machine
    (PSD/TGA/DDS/JXL always; HEIC/AVIF/RAW when the Store codec pack is absent). Native and
    per-architecture, so it is conditioned on $(Platform) (Win2D forbids AnyCPU anyway).
  -->
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.14.0" Condition="'$(Platform)' == 'x64'" />
    <PackageReference Include="Magick.NET-Q8-arm64" Version="14.14.0" Condition="'$(Platform)' == 'ARM64'" />
  </ItemGroup>

  <!-- M5: ImageSharp extracts composited animation frames for GIF/WebP/APNG (WIC only yields
       frame 0 for these). Managed, AnyCPU-safe. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- M7: MetadataExtractor reads EXIF/IPTC/XMP/GPS for the info panel without a pixel decode, and
       also gives the rotate-save path a robust EXIF-orientation read across formats. Managed, AnyCPU-safe. -->
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>
