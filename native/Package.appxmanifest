        <!-- file types: end -->

        <!-- `Looker photo.jpg` from any terminal (App Execution Alias). -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Looker.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="Looker.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
