<?xml version="1.0" encoding="utf-8"?>
<!--
  Looker's package: the same identity, file associations and alias as the C# app it replaced (tag
  csharp-final, src/Looker/Package.appxmanifest), so an install updates in place and keeps its LocalSettings, which the
  native app migrates on first launch. scripts/Publish-Native.ps1 lays it out and registers it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="fayewave.Looker-PhotoViewer"
    Publisher="CN=75645224-1CB5-47AA-A845-256EA45E9908"
    Version="2.1.40.0"
    ProcessorArchitecture="x64" />


  <Properties>
    <DisplayName>Looker - Photo Viewer</DisplayName>
    <PublisherDisplayName>fayewave</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="Looker.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Looker"
        Description="A fast, native photo viewer for Windows 11"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          File type associations: one per extension Looker opens, so it is offered in "Open with" and Settings >
          Default apps for all of them, each with its own icon and type name. Generated by scripts/New-FileIcons.ps1
          from format::EXTENSIONS (a unit test in format.rs checks they match) and scripts/file-icons/icons.js.
        -->
        <!-- file types: begin -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="jpg">
            <uap:DisplayName>JPG image</uap:DisplayName>
            <uap:Logo>Assets\FileIcons\jpg.png</uap:Logo>
            <uap:InfoTip>Open with Looker</uap:InfoTip>
            <uap:SupportedFileTypes><uap:FileType>.jpg</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="jpeg">
            <uap:DisplayName>JPEG image</uap:DisplayName>
            <uap:Logo>Assets\FileIcons\jpeg.png</uap:Logo>
            <uap:InfoTip>Open with Looker</uap:InfoTip>
            <uap:SupportedFileTypes><uap:FileType>.jpeg</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="jpe">
            <uap:DisplayName>JPE image</uap:DisplayName>
            <uap:Logo>Assets\FileIcons\jpe.png</uap:Logo>
            <uap:InfoTip>Open with Looker</uap:InfoTip>
            <uap:SupportedFileTypes><uap:FileType>.jpe</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="jfif">
            <uap:DisplayName>JFIF image</uap:DisplayName>
            <uap:Logo>Assets\FileIcons\jfif.png</uap:Logo>
            <uap:InfoTip>Open with Looker</uap:InfoTip>
            <uap:SupportedFileTypes><uap:FileType>.jfif</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="png">
            <uap:DisplayName>PNG image</uap:DisplayName>
            <uap:Logo>Assets\FileIcons\png.png</uap:Logo>
            <uap:InfoTip>Open with Looker</uap:InfoTip>
